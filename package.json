{
	"name": "obsidian-speech-bubbles",
	"version": "0.5.0",
	"description": "Renders transcription notes as message app style speech bubbles",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:watch": "node esbuild.config.mjs --watch",
		"prod": "node esbuild.config.mjs --production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"format": "prettier --write .",
		"test": "jest",
		"test:dev": "pnpm dev && jest",
		"test:watch": "pnpm dev && jest --watch",
		"coverage": "pnpm dev && jest --coverage",
		"lint": "eslint .",
		"lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
		"build": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format && pnpm prod && pnpm test",
		"ci": "pnpm install --frozen-lockfile",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"build:css": "csso src/styles.src.css --output styles.css",
		"release": "node release.mjs",
		"tag-release": "git tag $(node -p \"require('./package.json').version\") && git push origin --tags"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"speech-bubbles",
		"transcription"
	],
	"author": "Forketyfork",
	"license": "MIT",
	"engines": {
		"node": "^22.13.0 || >=24"
	},
	"packageManager": "pnpm@11.1.2",
	"devDependencies": {
		"@codemirror/state": "6.7.1",
		"@codemirror/view": "6.43.8",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "2.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.2.0",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"builtin-modules": "^5.3.0",
		"csso-cli": "^4.0.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.9.0",
		"jest": "^30.3.0",
		"jest-environment-jsdom": "^30.3.0",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.6",
		"stylelint": "^17.14.1",
		"stylelint-config-obsidianmd": "^0.1.0",
		"ts-jest": "^29.4.12",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.66.0"
	}
}
